{
  "name": "pi-minimalist-ui",
  "version": "0.1.0",
  "description": "An open-source minimalist editor UI extension for Pi.",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "license": "MIT",
  "author": "Zackery Griesinger",
  "repository": {
    "type": "git",
    "url": "https://github.com/zackerydev/pi-minimalist-ui.git"
  },
  "homepage": "https://github.com/zackerydev/pi-minimalist-ui#readme",
  "bugs": {
    "url": "https://github.com/zackerydev/pi-minimalist-ui/issues"
  },
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "terminal-ui",
    "minimalist-ui",
    "ai-agent",
    "coding-assistant",
    "developer-tools"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "assets/preview.png",
    "assets/preview.svg",
    "dist",
    "src",
    "!src/**/*.test.ts",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "pi": {
    "extensions": [
      "src/index.ts"
    ],
    "image": "https://raw.githubusercontent.com/zackerydev/pi-minimalist-ui/main/assets/preview.png"
  },
  "scripts": {
    "clean": "node --eval \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run test && npm run typecheck",
    "prepack": "npm run check && npm run build"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.80.7",
    "@earendil-works/pi-tui": "0.80.7",
    "@types/node": "^22.0.0",
    "prettier": "^3.9.5",
    "typebox": "^1.1.38",
    "typescript": "^5.9.3",
    "vitest": "^4.1.9"
  }
}
